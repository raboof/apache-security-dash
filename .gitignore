# JetBrainz IDEs
.idea/
*.iml

# Caches
/report-cache/
/email-classification/
/workspace/
__pycache__/
*.pyc

# Environment files
.env

# User-scope override — per-developer config (e.g. personal Gmail
# OAuth credentials path). The .apache-magpie-overrides/ directory and
# skill-scope overrides stay committed; this user-scope file does not.
/.apache-magpie-overrides/user.md

# Project-local per-machine settings (sandbox allowlist etc.).
/.claude/settings.local.json

# macOS Finder metadata
.DS_Store

# Scratch working directory for sweep runs (ad-hoc scripts + API dumps).
/.sweep-tmp/

# Per-developer Magpie configuration (personal, never committed).
/.apache-magpie-local/
